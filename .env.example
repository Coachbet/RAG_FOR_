# Copy to .env (`make install` does it) and fill in. .env is git-ignored: never commit a key.

# --- LLM -------------------------------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# groq | ollama | transformers  (ollama: `ollama pull qwen2.5:3b`, LLM_MODEL=qwen2.5:3b)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# model used to grade answers in the evaluation
GRADER_MODEL=llama-3.3-70b-versatile
OLLAMA_HOST=http://localhost:11434

# --- Retrieval ---------------------------------------------------------
# changing the embedding model requires `make index` again
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# dense | hybrid (embeddings + BM25 keywords)
RETRIEVAL_MODE=hybrid
TOP_K=4
# refusal threshold on the best cosine similarity: set it with `make sweep` (DEV split), not by hand
MIN_SCORE=0.80
CHUNK_WORDS=300
CHUNK_OVERLAP=40

# --- Classifier --------------------------------------------------------
CLASSIFIER_BASE=distilbert-base-uncased

# --- Data --------------------------------------------------------------
# contact sent in the User-Agent to the iFixit API (their usage rules ask for one)
IFIXIT_CONTACT=your-group-email@example.com
